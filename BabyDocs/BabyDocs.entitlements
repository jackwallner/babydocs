<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty.

	     Sign in with Apple went with the accounts: there is no account to sign
	     in to. `aps-environment` went with the server: every reminder this app
	     sends is scheduled locally from a date the phone already holds, so there
	     is no push, no device token, and nothing that stops working in airplane
	     mode.

	     An entitlement the app does not use is a capability reviewers ask about
	     and an attack surface nobody is watching, so neither goes back without a
	     feature that needs it. -->
</dict>
</plist>
