<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Baby Docs</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jackwallner.babydocs.plan</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>babydocs</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<!-- Asked only at the moment a parent taps "Add a document", never at
	     launch. All three strings say where the data goes, because that is the
	     only question worth answering when an app asks to photograph a Social
	     Security card. -->
	<key>NSCameraUsageDescription</key>
	<string>To photograph your baby's documents. The photos stay on this phone, are not backed up, and are never uploaded anywhere.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To add a document you have already photographed. The copy stays on this phone, is not backed up, and is never uploaded anywhere.</string>
	<!-- Used once, when you tap "Use my location" on the household questions, to
	     fill in your state and county. Never in the background, never stored,
	     never sent anywhere. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>To fill in your state and county on the household questions so you do not have to scroll for them. Your location is used once, on that screen, and is never stored or sent anywhere.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>To unlock your document vault. Your passcode works too.</string>
</dict>
</plist>
