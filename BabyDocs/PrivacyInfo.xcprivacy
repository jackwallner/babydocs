<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One collected type, and it is the purchase.

  Apple's definition of "collected" is data transmitted off the device. With the
  backend gone there is nothing left that qualifies except the purchase, which
  RevenueCat and Apple handle. The child's name, the birth date, the household
  answers, the notes, the confirmation numbers and every vault photograph stay in
  the app container on one phone and are never sent anywhere, so none of them are
  declared here. That is not an omission; declaring them would be a claim that
  they leave, and they do not.

  This file also used to declare health data, emergency contact phone numbers and
  an account id, none of which this app has ever had: it was inherited from a
  sibling app and never pruned. Anything added back has to be something this
  binary genuinely transmits.

  A note on the API reason codes: these were checked against Xcode's build-time
  privacy report rather than guessed. If a dependency is added, re-run that
  report rather than assuming this file is still complete.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- RevenueCat purchase history. Not linked to an identity: there is
			     no account in this app to link it to. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<!-- App functionality is the unlock. Analytics is the RevenueCat
			     dashboard: the charts are built from these same purchase events,
			     and RevenueCat's own App Privacy guidance says to declare the
			     purpose if you look at them, which we do. Declaring only
			     functionality would be understating it. -->
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Vault files: protection class on write, and the backup-exclusion
			     resource value re-applied on every read of the directory. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- The "on this phone" size in Settings. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
