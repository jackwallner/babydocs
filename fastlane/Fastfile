opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Download current metadata + screenshots from App Store Connect into /tmp/asc-live"
  lane :download_state do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("rm -rf /tmp/asc-live && mkdir -p /tmp/asc-live")

    deliver(
      api_key: api_key,
      run_precheck_before_submit: false,
      metadata_path: "/tmp/asc-live/metadata",
      screenshots_path: "/tmp/asc-live/screenshots",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots and metadata to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?

    skip_shots = ENV.fetch("SKIP_SCREENSHOTS", "false") == "true"
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1" unless skip_shots
    review_phone = ENV["ASC_REVIEW_PHONE"].to_s.strip
    UI.user_error!("Set ASC_REVIEW_PHONE to the real App Review contact number") if review_phone.empty?
    unless review_phone.match?(/\A\+\d[\d ()-]{6,}\z/)
      UI.user_error!("ASC_REVIEW_PHONE must start with + and include a valid phone number")
    end

    review_information = {
        first_name: "Jack",
        last_name: "Wallner",
        phone_number: review_phone,
        email_address: "jackwallner@gmail.com",
        demo_user: "No demo account required",
        demo_password: "",
        notes: <<~NOTES
          Baby Docs is an organizational tool for the administrative paperwork
          that follows a birth in the United States: the Social Security card,
          the birth certificate, health plan enrollment, parental leave and so
          on. It is a checklist and a reminder app. It does not file, submit or
          transmit any government, tax, insurance or legal form, and it does not
          ask for a Social Security number.

          The app works with no account. Every task, deadline, document
          checklist and official link is generated on device from the answers
          given during setup, so the whole plan is usable with no network at
          all. There is no sign-in step and nothing to create an account for.

          Two things do need a connection, and only these two: loading the
          prices on the Baby Docs Plus paywall, and making or restoring a
          purchase. Both go through RevenueCat and StoreKit. If the paywall is
          opened offline the prices will not load and the buy button stays
          disabled; reconnect and reopen it. The government links open in Safari
          and need a connection like any other link.

          Core flow:
          1. Launch and answer the setup questions (state, coverage, situation)
          2. The Plan tab shows the generated tasks, soonest deadline first
          3. Tap a task for why it applies, what documents to bring, and a link
             to the official government page for that task
          4. Children tab holds each child and the household answers
          5. Documents tab holds photographs of the paperwork itself
          6. Settings shows the date the whole rule set was last reviewed

          Sharing works and needs no account. "Send the plan" builds a link that
          carries the household answers in the URL fragment, which browsers
          never transmit to a server, and the other parent's copy of the app
          regenerates the same plan from them. There is no backend for household
          data anywhere in this app: nothing about a child, a plan or a document
          is uploaded, and the only network requests the app makes at all are the
          RevenueCat purchase calls described above.

          There is no rating prompt of our own. The app calls SKStoreReviewController
          through SwiftUI's requestReview environment action and nothing stands in
          front of it. "Send feedback" in Settings is a separate support action
          that opens a mail draft; it is available to everyone, at any time, and
          it does not lead to the App Store.

          The Documents tab stores photographs in the app container under
          complete file protection, excluded from backup. They never leave the
          device: no share sheet or export path can reach them, and the exported
          summaries print the status of a Social Security number, never a number.

          Baby Docs Plus (IAP via RevenueCat, weekly or yearly subscription or a
          one-time purchase) gates four things: additional children beyond the
          first, adding new photographs to the Documents tab after a child is
          twelve weeks old, the printable one-page summary, and the employer
          packet. Every task, deadline, document checklist, official link, the
          shared plan link and the follow-up tracking are free. If Plus lapses,
          existing photographs remain and remain viewable; only adding new ones
          stops.

          The app gives no legal, tax, medical or insurance advice, and carries
          a disclaimer to that effect in Settings and on every exported summary.
        NOTES
    }

    deliver(
      api_key: api_key,
      app_version: version,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 7,
      skip_binary_upload: true,
      skip_screenshots: skip_shots,
      sync_screenshots: !skip_shots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      app_review_information: review_information,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Submit the draft version for App Store review (metadata already uploaded)"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?
    build_number = ENV["ASC_BUILD_NUMBER"]
    UI.user_error!("Set ASC_BUILD_NUMBER") unless build_number && !build_number.empty?

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
