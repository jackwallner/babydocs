opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Download current metadata + screenshots from App Store Connect into /tmp/asc-live"
  lane :download_state do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("rm -rf /tmp/asc-live && mkdir -p /tmp/asc-live")

    deliver(
      api_key: api_key,
      run_precheck_before_submit: false,
      metadata_path: "/tmp/asc-live/metadata",
      screenshots_path: "/tmp/asc-live/screenshots",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots and metadata to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?

    skip_shots = ENV.fetch("SKIP_SCREENSHOTS", "false") == "true"
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1" unless skip_shots
    review_phone = ENV["ASC_REVIEW_PHONE"].to_s.strip
    UI.user_error!("Set ASC_REVIEW_PHONE to the real App Review contact number") if review_phone.empty?
    unless review_phone.match?(/\A\+\d[\d ()-]{6,}\z/)
      UI.user_error!("ASC_REVIEW_PHONE must start with + and include a valid phone number")
    end

    review_information = {
        first_name: "Jack",
        last_name: "Wallner",
        phone_number: review_phone,
        email_address: "jackwallner@gmail.com",
        demo_user: "No demo account required",
        demo_password: "",
        notes: <<~NOTES
          Baby Docs is an organizational checklist for the administrative
          paperwork after a US birth: the Social Security card, birth
          certificate, health-plan enrollment and parental leave. It does not
          file, submit or transmit any government, tax, insurance or legal form,
          and it never asks for a Social Security number.

          No account is needed. The plan is generated on device from setup
          answers and works offline. Network use is limited to RevenueCat and
          StoreKit for prices and purchases, plus the optional location helper.
          The helper runs only after the reviewer taps it, asks Apple's
          geocoding service for a state and county, then discards the position.
          Government links open in Safari.

          Core flow: launch, answer the state, coverage and household questions,
          then the intake offers Baby Docs Plus on its last page, which can be
          skipped with "Continue with the free plan", and lands on the Plan tab. Each task explains why it applies, what to
          bring and where to go. Children holds household answers, Documents
          holds paperwork photos, and Settings shows the source review date.

          Paid-feature paths, all reachable from the Plus tab, which shows the
          offer before purchase and the tools after it:
          1. Suggested-date reminders and the Sunday digest: Plus tab, "What
             gets said out loud". Free devices still receive both warnings for
             the two deadlines that legally close.
          2. Recommended order: Plus tab, the timeline sections at the top.
             Tasks that wait on another task are shown as waiting rather than
             as work.
          3. A reminder the parent sets: Plan, open any task, "Your own
             reminder".
          4. Calendar export: Plus tab, "Put the dates in a calendar".
          5. Follow-up tracking: Plan, open a sent task, tap "Sent it". Plus
             unlocks the follow-up date and reminder.
          6. Document vault after twelve weeks: Documents, Photos, "Add a
             document". Plus unlocks adding new photos. Existing photos remain
             viewable after a lapse.
          7. Printable summary: Plus tab, or Plan, Plan options, "Send or print
             this plan", then "One-page summary".
          8. Employer packet: choose Coverage "Through a job", then Plus tab or
             Children, select a child, "Send or print this plan", then
             "Employer packet".

          Every task, deadline, document list, official link, additional child
          and shared plan link is free, as are the reminders for the two
          deadlines that legally close. "Send the plan" carries answers in the
          URL fragment so the other parent's app can rebuild the same plan
          without a backend. There is no live sync. A Plus lapse stops new
          photos only; existing photos remain on the device.

          The app's only review action is the system requestReview call, with no
          custom question or rating gate. "Send feedback" in Settings opens
          support and never routes to the App Store. Vault photos use complete
          file protection, are excluded from backup and have no share or export
          path. Exports print Social Security status, never a number.

          The app gives no legal, tax, medical or insurance advice. Its
          disclaimer appears in Settings and on exported summaries.
        NOTES
    }

    deliver(
      api_key: api_key,
      app_version: version,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 7,
      skip_binary_upload: true,
      skip_screenshots: skip_shots,
      sync_screenshots: !skip_shots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      app_review_information: review_information,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Submit the draft version for App Store review (metadata already uploaded)"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?
    build_number = ENV["ASC_BUILD_NUMBER"]
    UI.user_error!("Set ASC_BUILD_NUMBER") unless build_number && !build_number.empty?

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
